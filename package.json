    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "build:lib:prod": "vite build",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "bootstrap": "^5.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sass": "^1.86.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^3.9.1"
  }
}
