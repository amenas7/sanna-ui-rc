{
  "name": "sanna-ui-rc",
  "version": "0.0.3",
  "description": "Librería de componentes React basada en Bootstrap 5",
  "type": "module",
  "main": "dist/sanna-ui-rc.cjs.js",
  "module": "dist/sanna-ui-rc.es.js",
  "types": "dist/index.d.ts",
